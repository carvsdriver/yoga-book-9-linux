[Unit]
Description=Dual screen rotation for Yoga Book 9i
After=graphical.target

[Service]
User=pickles
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
Environment=WAYLAND_DISPLAY=wayland-0
ExecStartPre=/bin/bash -c 'until [ -S /run/user/1000/wayland-0 ]; do sleep 1; done; sleep 5'
ExecStart=/usr/local/bin/rotate-screens.sh
Restart=always
RestartSec=5

[Install]
WantedBy=graphical.target
